---
/**
 * Prefixed CMS pages for LT/SE. English requests redirect to unprefixed URLs.
 */
import CmsPage from '../../components/CmsPage.astro';
import { isLocale, type Locale } from '../../lib/locales';
import { localePath } from '../../lib/paths';

const rawLang = Astro.params.lang;
const slug = Astro.params.slug;

if (!isLocale(rawLang) || !slug) {
  return Astro.redirect('/', 302);
}

const locale = rawLang as Locale;

// Default locale must not live under /en/…
if (locale === 'en') {
  if (slug === 'home') return Astro.redirect('/', 301);
  return Astro.redirect(localePath('en', `/${slug}`), 301);
}

if (slug === 'blog') {
  return Astro.redirect(localePath(locale, '/blog'), 302);
}

---
<CmsPage locale={locale} slug={slug} />
