---
import type { Locale } from '../lib/locales';

type Props = { locale: Locale; class?: string };
const { locale, class: className = 'lang-dropdown__flag' } = Astro.props;
const uid = `${locale}-${Math.random().toString(36).slice(2, 8)}`;
---

{
  locale === 'en' ? (
    <svg class={className} viewBox="0 0 40 40" width="20" height="20" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id={`flag-${uid}`}><circle cx="20" cy="20" r="20" /></clipPath>
      </defs>
      <g clip-path={`url(#flag-${uid})`}>
        <rect width="40" height="40" fill="#012169" />
        <path d="M0 0 L40 40 M40 0 L0 40" stroke="#fff" stroke-width="6" />
        <path d="M0 0 L40 40 M40 0 L0 40" stroke="#C8102E" stroke-width="3.5" />
        <path d="M20 0 V40 M0 20 H40" stroke="#fff" stroke-width="10" />
        <path d="M20 0 V40 M0 20 H40" stroke="#C8102E" stroke-width="6" />
      </g>
    </svg>
  ) : locale === 'lt' ? (
    <svg class={className} viewBox="0 0 40 40" width="20" height="20" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id={`flag-${uid}`}><circle cx="20" cy="20" r="20" /></clipPath>
      </defs>
      <g clip-path={`url(#flag-${uid})`}>
        <rect width="40" height="40" fill="#FDB913" />
        <rect y="13.33" width="40" height="13.34" fill="#006A44" />
        <rect y="26.67" width="40" height="13.33" fill="#C1272D" />
      </g>
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 40 40" width="20" height="20" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id={`flag-${uid}`}><circle cx="20" cy="20" r="20" /></clipPath>
      </defs>
      <g clip-path={`url(#flag-${uid})`}>
        <rect width="40" height="40" fill="#006AA7" />
        <rect x="12" width="6" height="40" fill="#FECC00" />
        <rect y="17" width="40" height="6" fill="#FECC00" />
      </g>
    </svg>
  )
}
