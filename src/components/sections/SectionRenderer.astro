---
import type { CmsSection } from '../../lib/cms';
import { isModernHomeLocale, type Locale } from '../../lib/locales';
import { localePath } from '../../lib/paths';
import {
  Benefits,
  CaseStudies,
  Hero,
  JobList,
  LogoStrip,
  PageHero,
  Problem,
  RichText,
  Steps,
  Testimonial,
} from './Blocks';
import CapacityCalculator from './CapacityCalculator';
import ArlandaCase from './ArlandaCase';
import HomeFeatures from './HomeFeatures';
import HomeFeatureAnnounce from './HomeFeatureAnnounce';
import { HomeFaq, HomeIndustries } from './HomeJourney';
import DemoForm from './DemoForm';

type FormField = {
  target: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  format?: string;
  minLength?: number;
  maxLength?: number;
  pattern?: string;
  viewFieldType?: string;
  options?: Array<{ value: string; label: string }>;
};

type Props = {
  sections: CmsSection[];
  formFields?: FormField[];
  formId?: string;
  formLoadError?: string;
  locale?: Locale;
  pageSlug?: string;
  pageLabel?: string;
};

const {
  sections,
  formFields = [],
  formId,
  formLoadError,
  locale = 'en',
  pageSlug = '',
  pageLabel = '',
} = Astro.props as Props;

const SIMPLE_HERO_SLUGS = new Set(['jobs', 'get-in-touch']);
const useModernHome = isModernHomeLocale(locale) && pageSlug === 'home';
const heroSection = sections.find((s) => (s.type || '').trim() === 'hero');
const logoSection = sections.find((s) => (s.type || '').trim() === 'logoStrip');

const SUPPORTED =
  'hero, logoStrip, problem, steps, benefits, testimonial, caseStudies, demoForm, richText, jobList';
---

{
  useModernHome && heroSection && (
    <div class="home-top-band">
      <Hero section={heroSection} locale={locale} />
      {logoSection && <LogoStrip section={logoSection} locale={locale} />}
    </div>
  )
}
{
  useModernHome && logoSection && (
    <>
      <HomeFeatures />
      <CapacityCalculator client:load demoHref={localePath(locale, '/get-in-touch')} />
      <ArlandaCase client:load />
      <HomeFeatureAnnounce demoHref={localePath(locale, '/get-in-touch')} />
      <HomeIndustries client:load locale={locale} />
      <HomeFaq locale={locale} />
    </>
  )
}
{
  sections.map((section) => {
    const type = (section.type || '').trim();
    // Modern home (EN/SE): custom stack above; skip CMS problem / benefits / testimonial too.
    if (
      useModernHome &&
      (type === 'hero' ||
        type === 'logoStrip' ||
        type === 'problem' ||
        type === 'benefits' ||
        type === 'testimonial')
    ) {
      return null;
    }
    switch (type) {
      case 'hero':
        if (SIMPLE_HERO_SLUGS.has(pageSlug) && pageLabel) {
          return <PageHero label={pageLabel} />;
        }
        return <Hero section={section} locale={locale} />;
      case 'logoStrip':
        return <LogoStrip section={section} locale={locale} />;
      case 'problem':
        return <Problem section={section} />;
      case 'steps':
        // Modern home already surfaces these four steps in section 2 — skip the duplicate block.
        if (useModernHome) return null;
        return <Steps section={section} />;
      case 'benefits':
        return <Benefits section={section} locale={locale} />;
      case 'testimonial':
        return <Testimonial section={section} />;
      case 'caseStudies':
        return <CaseStudies section={section} />;
      case 'richText':
        return <RichText section={section} />;
      case 'jobList':
        return <JobList section={section} />;
      case 'demoForm':
        return (
          <DemoForm
            client:load
            heading={section.heading}
            subheading={section.subheading}
            fields={formFields}
            formId={formId}
            loadError={formLoadError}
            locale={locale}
          />
        );
      default:
        return (
          <section class="shell__inner">
            <p class="dev-msg">
              Unknown section type “{type || '(empty)'}”. Supported: {SUPPORTED}.
            </p>
          </section>
        );
    }
  })
}
