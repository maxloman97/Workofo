---
import type { CmsSection } from '../../lib/cms';
import type { Locale } from '../../lib/locales';
import {
  Benefits,
  CaseStudies,
  Hero,
  JobList,
  LogoStrip,
  PageHero,
  Problem,
  RichText,
  Steps,
  Testimonial,
} from './Blocks';
import CapacityCalculator from './CapacityCalculator';
import HowItWorks from './HowItWorks';
import { HomeFaq, HomeIndustries, HomeProof } from './HomeJourney';
import { parseItemsJson } from '../../lib/rich';
import DemoForm from './DemoForm';

type FormField = {
  target: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  format?: string;
  minLength?: number;
  maxLength?: number;
  pattern?: string;
  viewFieldType?: string;
  options?: Array<{ value: string; label: string }>;
};

type Props = {
  sections: CmsSection[];
  formFields?: FormField[];
  formId?: string;
  formLoadError?: string;
  locale?: Locale;
  pageSlug?: string;
  pageLabel?: string;
};

const {
  sections,
  formFields = [],
  formId,
  formLoadError,
  locale = 'en',
  pageSlug = '',
  pageLabel = '',
} = Astro.props as Props;

const SIMPLE_HERO_SLUGS = new Set(['jobs', 'get-in-touch']);
const showCapacityCalc = locale === 'en' && pageSlug === 'home';
const stepsSection = showCapacityCalc ? sections.find((s) => (s.type || '').trim() === 'steps') : undefined;
const howItWorksSteps = stepsSection
  ? parseItemsJson<{ title?: string; body?: string }>(stepsSection.items)
      .filter((item) => item.title)
      .map((item) => ({ title: item.title as string, body: item.body }))
  : [];

const SUPPORTED =
  'hero, logoStrip, problem, steps, benefits, testimonial, caseStudies, demoForm, richText, jobList';
---

{
  sections.map((section) => {
    const type = (section.type || '').trim();
    switch (type) {
      case 'hero':
        if (SIMPLE_HERO_SLUGS.has(pageSlug) && pageLabel) {
          return <PageHero label={pageLabel} />;
        }
        return <Hero section={section} locale={locale} />;
      case 'logoStrip':
        return (
          <>
            <LogoStrip section={section} locale={locale} />
            {showCapacityCalc && (
              <CapacityCalculator client:load demoHref={`/${locale}/get-in-touch`} />
            )}
            {showCapacityCalc && howItWorksSteps.length > 0 && (
              <HowItWorks
                client:visible
                steps={howItWorksSteps}
                note={stepsSection?.ctaLabel}
                demoHref={`/${locale}/get-in-touch`}
              />
            )}
            {showCapacityCalc && (
              <>
                <HomeIndustries locale={locale} />
                <HomeProof />
                <HomeFaq locale={locale} />
              </>
            )}
          </>
        );
      case 'problem':
        return <Problem section={section} />;
      case 'steps':
        return <Steps section={section} />;
      case 'benefits':
        return <Benefits section={section} locale={locale} />;
      case 'testimonial':
        return <Testimonial section={section} />;
      case 'caseStudies':
        return <CaseStudies section={section} />;
      case 'richText':
        return <RichText section={section} />;
      case 'jobList':
        return <JobList section={section} />;
      case 'demoForm':
        return (
          <DemoForm
            client:load
            heading={section.heading}
            subheading={section.subheading}
            fields={formFields}
            formId={formId}
            loadError={formLoadError}
            locale={locale}
          />
        );
      default:
        return (
          <section class="shell__inner">
            <p class="dev-msg">
              Unknown section type “{type || '(empty)'}”. Supported: {SUPPORTED}.
            </p>
          </section>
        );
    }
  })
}
